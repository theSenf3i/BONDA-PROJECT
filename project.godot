config_version=5

[application]
config/name="BONDAONDA — Dimensão Dedadão"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Abertura no void VHS e dimensão Dedadão. Feito em Godot."
config/version="0.6-dark-street"
config/use_custom_user_dir=true
config/custom_user_dir_name="runtime"

[debug]
file_logging/enable_file_logging.pc=false
file_logging/log_path="user://game.log"
file_logging/max_log_files=2

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
shader_compiler/shader_cache/enabled=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.15,0.12,0.2,1)

[audio]
driver/enable_input=false
